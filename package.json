    "sql.js": "^1.13.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "prisma": "6.1.0",
    "tailwindcss": "3.4.16",
    "tsx": "4.19.2",
