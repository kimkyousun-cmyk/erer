# Local development (SQLite)
DATABASE_URL="file:./dev.db"

# Canonical site URL used for metadata, sitemap, and OG images
NEXT_PUBLIC_SITE_URL="https://example.com"

# Cron protection secret (required for /api/cron/*)
CRON_SECRET="change-me-cron-secret"
CRON_BASE_URL="http://localhost:3000"

# Session and hashing secrets
SESSION_SECRET="change-me-session-secret"
API_KEYS_SALT="change-me-api-salt"

# Shorts / webhook secrets
SHORTS_WEBHOOK_SECRET="change-me-shorts-secret"

# Generator mode: mock | llm
GENERATOR_MODE="mock"
# Optional: set when using a real LLM generator implementation
LLM_API_KEY=""

# Safety gates
# If true, allows publishing requiresEdit issues (not recommended)
ALLOW_UNSAFE_PUBLISH="false"

# Panic switches (incident response)
DISABLE_GENERATION="false"
DISABLE_EXPORTS="false"
DISABLE_WEBHOOKS="false"
DISABLE_SIGNUP="false"
READ_ONLY_MODE="false"

# Demo mode: disables Prisma initialization so the app can run
# with seed-data fallbacks even when OpenSSL is missing.
DEMO_MODE="false"

# Admin gate (recommended in any public deployment)
ADMIN_PASSWORD=""

# For Cloudflare Pages demo deployments:
# DEMO_MODE="true"
